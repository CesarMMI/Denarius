# Copie para `.env` e preencha antes de rodar `docker compose up` de dentro de api/.
# NUNCA commitar `.env`.
# Só configura infraestrutura (o container do MariaDB e o mapeamento de porta do host) —
# a config da aplicação (JWT, connection string, CORS, logging) vive em
# src/Denarius.Api/appsettings.json (veja appsettings.json.example), não aqui.
MARIADB_ROOT_PASSWORD=changeme
MARIADB_DATABASE=denarius
API_PORT=8080
