# Copie para `.env` e preencha antes de rodar `docker compose up` de dentro de api/. NUNCA commitar `.env`.
MARIADB_ROOT_PASSWORD=changeme
MARIADB_DATABASE=denarius
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
JWT_ISSUER=Denarius
JWT_AUDIENCE=Denarius
JWT_EXPIRY_MINUTES=60
API_PORT=8080

# Nível de log (Trace, Debug, Information, Warning, Error, Critical, None)
LOGGING_DEFAULT_LEVEL=Information
LOGGING_ASPNETCORE_LEVEL=Warning

# CORS: listas separadas por vírgula. Vazio = permissivo (AllowAny*) — ok para dev,
# restrinja antes de produção com a(s) URL(s) real(is) do front.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=
CORS_ALLOWED_HEADERS=
